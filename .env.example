# PostgreSQL password (choose a strong random string)
DB_PASSWORD=change_me_strong_password

# JWT signing secret (choose a strong random string)
JWT_SECRET=change_me_jwt_secret

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP) — e.g. Gmail App Password or Hostinger email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@yourdomain.com
SMTP_PASS=your_email_password

# Your domain (https://yourdomain.com)
ALLOWED_ORIGINS=https://yourdomain.com

# Admin login for the dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# Vercel Blob (for image uploads — copy from your current Vercel project)
BLOB_READ_WRITE_TOKEN=vercel_blob_...
